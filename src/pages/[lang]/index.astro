---
import type { GetStaticPaths, InferGetStaticParamsType } from "astro";

import SiteFooter from "@/components/footer/SiteFooter.astro";
import { siteTexts } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales } from "@/lib/i18n";
import Hero from "@/sections/hero/Hero.astro";
import AboutSection from "@/sections/about/AboutSection.astro";
import ContactSection from "@/sections/contact/ContactSection.astro";
import ProcessSection from "@/sections/process/ProcessSection.astro";
import ProjectsSection from "@/sections/projects/ProjectsSection.astro";

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;

const { lang } = Astro.params as Params;
const { title, description } = siteTexts[lang];
---

<BaseLayout lang={lang} title={title} description={description} isHome>
  <div class="home">
    <Hero lang={lang} />
    <ProjectsSection lang={lang} />
    <div class="home-rest">
      <AboutSection lang={lang} />
      <ProcessSection lang={lang} />
      <ContactSection lang={lang} />
    </div>
  </div>
  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /*
   * The home scrolls by chapters (docs/architecture.md §20): the Hero and the
   * projects always rest at their start, never between the two. Otherwise,
   * scrolling from the Hero with the pointer in the middle, the folder's own
   * scroll took over before the folder was in place. Everything after the
   * projects is one more chapter (.home-rest), taller than the screen, so it
   * scrolls freely inside: with a chapter per section, from the end of one
   * the next one's start was more than half a screen away, and a regular
   * gesture bounced back as if against a wall. The margin keeps sections
   * below the sticky header (4rem plus its 1px border), for anchors too.
   */
  :global(html:has(.home)) {
    scroll-snap-type: y mandatory;
  }

  .home > :global(section),
  .home-rest {
    scroll-snap-align: start;
  }

  /*
   * No gesture skips a chapter's start. The free chapter accepts any point
   * as a place to rest, so a strong trackpad or touch fling went from the
   * Hero past the projects, or from the projects past the About section's
   * opening, with its intro already lit. A fling up from inside the free
   * chapter stops at its start too, before the projects.
   */
  .home > :global(section),
  .home-rest {
    scroll-snap-stop: always;
  }

  .home > :global(section),
  .home-rest,
  .home-rest > :global(section) {
    scroll-margin-top: calc(4rem + 1px);
  }

  /* The footer is outside the free chapter (it's the page's, not the home's): aligned to the bottom, the end of the page is a place to rest too. */
  :global(html:has(.home) .site-footer) {
    scroll-snap-align: end;
  }

  /* The Hero dims in step with the folder's entry, whose timeline is the projects section's (docs/projects.md §42.6): this shares it with the Hero, which isn't inside that section. */
  .home {
    timeline-scope: --projects-entry;
  }

  /*
   * Tilted, the folder is wider than the screen (27px more at 1440px), and
   * the page could be dragged sideways until it landed. Clipped, not hidden:
   * clip makes no scroll container, so the About section's pinned phrase
   * still sticks to the screen.
   */
  .home {
    overflow-x: clip;
  }
</style>
