---
import { getRelativeLocaleUrl } from "astro:i18n";

import Signature from "@/assets/images/signature.svg";
import { siteName } from "@/config/site";
import DocumentLayout from "@/layouts/DocumentLayout.astro";
import { defaultLocale, locales, type Locale } from "@/lib/i18n";

interface NotFoundTexts {
  heading: string;
  body: string;
  home: string;
}

// Vercel serves a single 404 page for every missing URL, whatever its language: it speaks both.
const texts = {
  es: {
    heading: "Esta página no existe.",
    body: "Puede que el link esté mal escrito, o que la página se haya movido.",
    home: "Ir al inicio",
  },
  en: {
    heading: "This page doesn't exist.",
    body: "The link may be mistyped, or the page may have moved.",
    home: "Go to the home page",
  },
} satisfies Record<Locale, NotFoundTexts>;
---

<DocumentLayout
  lang={defaultLocale}
  title={`Página no encontrada · Page not found — ${siteName}`}
>
  <header class="border-b border-border">
    <div class="mx-auto flex h-16 max-w-6xl items-center px-4">
      <a href="/" aria-label={siteName}>
        <Signature class="h-12 w-auto" aria-hidden="true" />
      </a>
    </div>
  </header>
  <main class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <h1 class="font-display text-8xl font-extrabold tracking-tight text-accent md:text-9xl">
      404
    </h1>
    <div class="mt-10 grid gap-12 md:grid-cols-2">
      {locales.map((lang) => (
        <div lang={lang}>
          <h2 class="text-2xl font-semibold">{texts[lang].heading}</h2>
          <p class="mt-3 text-muted">{texts[lang].body}</p>
          <a
            href={getRelativeLocaleUrl(lang)}
            class="mt-6 inline-block rounded-full bg-accent px-6 py-3 text-accent-foreground"
          >
            {texts[lang].home}
          </a>
        </div>
      ))}
    </div>
  </main>
</DocumentLayout>
