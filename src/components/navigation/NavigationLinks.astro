---
import { sections } from "@/config/navigation";
import type { Locale } from "@/lib/i18n";
import { getSectionPath } from "@/lib/locale-url";

import { navigationTexts } from "./navigation.texts";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const { links } = navigationTexts[lang];
---

<ul class={className}>
  {sections.map((section) => (
    <li>
      <a href={getSectionPath(lang, section)}>{links[section]}</a>
    </li>
  ))}
</ul>
