---
import { getRelativeLocaleUrl } from "astro:i18n";

import { sectionIds, sections } from "@/config/navigation";
import type { Locale } from "@/lib/i18n";

import { navigationTexts } from "./navigation.texts";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const { links } = navigationTexts[lang];
const homePath = getRelativeLocaleUrl(lang);
---

<ul class={className}>
  {sections.map((section) => (
    <li>
      <a href={`${homePath}#${sectionIds[lang][section]}`}>{links[section]}</a>
    </li>
  ))}
</ul>
