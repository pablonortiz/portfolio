---
import { cvPaths } from "@/config/contact";
import { sections } from "@/config/navigation";
import type { Locale } from "@/lib/i18n";
import { getSectionPath } from "@/lib/locale-url";

import { navigationTexts } from "../navigation.texts";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const { links, cv, cvLabel } = navigationTexts[lang];
---

<ul class={className}>
  {sections.map((section) => (
    <li>
      <a href={getSectionPath(lang, section)}>{links[section]}</a>
    </li>
  ))}
  <li>
    <a href={cvPaths[lang]} download aria-label={cvLabel}>
      {cv}
    </a>
  </li>
</ul>
