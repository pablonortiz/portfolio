---
import MoonIcon from "@/assets/icons/moon.svg";
import SunIcon from "@/assets/icons/sun.svg";
import type { Locale } from "@/lib/i18n";

import { navigationTexts } from "../navigation.texts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { darkTheme } = navigationTexts[lang];
---

<button
  type="button"
  data-theme-toggle
  aria-label={darkTheme}
  aria-pressed="false"
  class="p-2"
>
  <MoonIcon class="theme-icon-moon size-5" aria-hidden="true" />
  <SunIcon class="theme-icon-sun size-5" aria-hidden="true" />
</button>

<script>
  import { onEveryPage } from "@/lib/page-lifecycle";

  import { setupThemeToggle } from "../lib/theme-toggle";

  onEveryPage((signal) =>
    document
      .querySelectorAll<HTMLElement>("[data-theme-toggle]")
      .forEach((toggle) => setupThemeToggle(toggle, signal)),
  );
</script>

<style>
  .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-icon-sun {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .theme-icon-moon {
      display: none;
    }
  }
</style>
