---
import { sectionIds } from "@/config/navigation";
import type { Locale } from "@/lib/i18n";
import { getProjects } from "@/lib/projects";

import ProjectFolder from "./ui/ProjectFolder.astro";
import { projectsTexts } from "./projects.texts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
---

<section
  id={sectionIds[lang].projects}
  aria-labelledby="projects-title"
  class="projects-section mx-auto max-w-6xl px-6 py-8"
>
  <h2 id="projects-title" class="sr-only">
    {projectsTexts[lang].sectionTitle}
  </h2>
  <div class="projects-rise" data-folder-rise>
    <ProjectFolder lang={lang} projects={projects} />
  </div>
</section>

<script>
  import { onEveryPage } from "@/lib/page-lifecycle";

  import { setupFolderLanding } from "./lib/folder-landing";

  onEveryPage((signal) =>
    document
      .querySelectorAll<HTMLElement>(".projects-section")
      .forEach((section) => setupFolderLanding(section, signal)),
  );
</script>

<style>
  /*
   * The folder lands (docs/projects.md §42.6): it travels tilted back from its
   * tabs, like a lid, and once in place it flattens on its own time
   * (lib/folder-landing.ts sets and clears data-landing). Flat is the base
   * state: without JS or with reduced motion it's just there.
   */
  .projects-rise {
    transform-origin: 50% 0;
  }

  .projects-rise[data-landing] {
    transform: perspective(1400px) rotateX(38deg);
    translate: 0 3rem;
    scale: 0.94;
    opacity: 0.3;
  }

  /*
   * Only flattening animates. Tilting is instant (on load and when it leaves,
   * always out of view): animated, it ran for 800ms after load and a quick
   * scroll caught it halfway. In-out, so the tilt holds a moment on arrival:
   * with ease-out it was almost flat within 200ms.
   */
  @media (prefers-reduced-motion: no-preference) {
    .projects-rise:not([data-landing]) {
      transition:
        transform var(--duration-slow) var(--ease-in-out),
        translate var(--duration-slow) var(--ease-in-out),
        scale var(--duration-slow) var(--ease-in-out),
        opacity var(--duration-slow) var(--ease-in-out);
    }
  }

  /*
   * The tilted folder overflows its section, and as the page's last section
   * that made the page taller: while it flattened, the scroll range shrank
   * frame by frame and the browser clamped the scroll at the very start of
   * the landing. Clipped, the tilt never changes the range.
   */
  .projects-section {
    overflow-y: clip;
  }

  /* The Hero dims while this section enters (its timeline is shared by the home page). */
  @supports (animation-timeline: view()) {
    .projects-section {
      view-timeline-name: --projects-entry;
    }
  }
</style>
