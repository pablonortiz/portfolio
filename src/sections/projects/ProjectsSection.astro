---
import { sectionIds } from "@/config/navigation";
import type { Locale } from "@/lib/i18n";
import { getProjects } from "@/lib/projects";

import ProjectFolder from "./ui/ProjectFolder.astro";
import { projectsTexts } from "./projects.texts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
---

<section
  id={sectionIds[lang].projects}
  aria-labelledby="projects-title"
  class="mx-auto max-w-6xl scroll-mt-16 px-6 py-8"
>
  <h2 id="projects-title" class="sr-only">
    {projectsTexts[lang].sectionTitle}
  </h2>
  <ProjectFolder lang={lang} projects={projects} />
</section>
