---
import { Picture } from "astro:assets";
import { render } from "astro:content";

import ArrowLeftIcon from "@/assets/icons/arrow-left.svg";
import ArrowUpRightIcon from "@/assets/icons/arrow-up-right.svg";
import type { Locale } from "@/lib/i18n";
import { getDemoUrl, getSectionPath } from "@/lib/locale-url";
import { isPackage, type Project } from "@/lib/projects";

import PackagePanel from "./ui/PackagePanel.astro";
import ProjectBackdrop from "./ui/ProjectBackdrop.astro";
import ProjectTour from "./ui/ProjectTour.astro";
import TechnologyList from "./ui/TechnologyList.astro";
import { projectsTexts } from "./projects.texts";

interface Props {
  lang: Locale;
  project: Project;
}

const { lang, project } = Astro.props;
const texts = projectsTexts[lang];
const { Content } = await render(project.body);
/** The header's action: an npm package's code, or an app's demo if it has one. */
const action = isPackage(project)
  ? { href: project.repository, label: texts.viewCode }
  : project.demo && {
      href: getDemoUrl(project.demo, lang),
      label: texts.tryIt,
    };
---

{!isPackage(project) && <ProjectBackdrop project={project} />}

<article class="project-detail">
  <header class="detail-header">
    <a
      href={getSectionPath(lang, "projects", {
        [texts.urlParam]: project.category,
      })}
      class="inline-flex items-center gap-2 font-mono text-sm text-muted hover:text-foreground"
      data-project-back
      data-slug={project.slug}
    >
      <ArrowLeftIcon class="size-4" aria-hidden="true" />
      {texts.back}
    </a>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="font-display text-4xl font-extrabold tracking-tight md:text-5xl">
        {project.title}
      </h1>
      {action && (
        <a
          href={action.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-accent-foreground"
        >
          {action.label}
          <ArrowUpRightIcon class="size-4" aria-hidden="true" />
          <span class="sr-only">{texts.opensInNewTab}</span>
        </a>
      )}
    </div>
    {project.fictionalBrand && (
      <p class="font-mono text-sm text-muted">{texts.fictionalBrandNote}</p>
    )}
  </header>

  <div
    class="detail-text"
    tabindex="0"
    role="region"
    aria-label={texts.descriptionLabel}
  >
    <section>
      <h2 class="detail-label">{texts.problem}</h2>
      <p class="mt-3">{project.problem}</p>
    </section>
    <section>
      <h2 class="detail-label">{texts.solution}</h2>
      <p class="mt-3">{project.solution}</p>
    </section>
    <section>
      <h2 class="detail-label">{texts.technical}</h2>
      <div class="technical-body mt-3">
        <Content />
      </div>
    </section>
  </div>

  <div class="detail-media">
    {isPackage(project) ? (
      <PackagePanel lang={lang} project={project} />
    ) : project.tour ? (
      <ProjectTour
        lang={lang}
        project={project}
        description={project.tour.description}
      />
    ) : (
      <Picture
        src={project.poster}
        alt=""
        formats={["avif", "webp"]}
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 32rem, 90vw"
        class="detail-media-image"
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div>

  <section class="detail-stack">
    <h2 class="detail-label">{texts.stack}</h2>
    <TechnologyList technologies={project.stack} label={texts.stack} />
  </section>
</article>

<script>
  import { onEveryPage } from "@/lib/page-lifecycle";

  import { setupProjectBack } from "./lib/project-return";
  import { releaseClipPlaceholders } from "./lib/project-zoom";

  releaseClipPlaceholders();
  onEveryPage((signal) =>
    document
      .querySelectorAll<HTMLAnchorElement>("[data-project-back]")
      .forEach((link) => setupProjectBack(link, signal)),
  );
</script>

<style>
  /*
   * Mobile: one column that scrolls with the page, the image right after the
   * title. Desktop: exactly one screen below the sticky header (4rem plus its
   * 1px border); if the text doesn't fit, its own column scrolls.
   */
  .project-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "header" "media" "text" "stack";
    gap: 2rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.5rem;
  }

  @media (width >= 48rem) {
    .project-detail {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas: "header header" "text media" "stack stack";
      gap: 2rem 3rem;
      height: calc(100dvh - 4rem - 1px);
      padding-block: 2rem;
    }

    .detail-text {
      overflow-y: auto;
      padding-inline-end: 1rem;
    }

    /* The tour's poster sizes itself to this area (ProjectTour). */
    .detail-media {
      container-type: size;
    }
  }

  /* Hidden while the zoom brings the frame in; it fades in as the frame blurs (ProjectBackdrop). */
  .project-detail {
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  :global(html[data-project-arrival]) .project-detail {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-detail {
      transition: none;
    }
  }

  .detail-header {
    grid-area: header;
    display: grid;
    gap: 1rem;
  }

  .detail-text {
    grid-area: text;
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  .detail-media {
    grid-area: media;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-height: 0;
  }

  .detail-media :global(.detail-media-image) {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    border-radius: 0.75rem;
    object-fit: contain;
  }

  .detail-stack {
    grid-area: stack;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .technical-body :global(* + *) {
    margin-top: 1em;
  }

  /*
   * When the text column scrolls, its bottom edge fades out to show there's
   * more, until the end is reached. Tied to its own scroll; with nothing to
   * scroll the timeline is inactive and there's no fade. Longhands because the
   * build's minifier breaks the shorthand plus animation-timeline.
   */
  @property --text-fade {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @supports (animation-timeline: scroll()) {
    .detail-text {
      mask-image: linear-gradient(
        to bottom,
        black calc(100% - var(--text-fade)),
        transparent
      );
      animation-name: text-fade-until-end;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: scroll(self);
    }
  }

  @keyframes text-fade-until-end {
    0%,
    90% {
      --text-fade: 3rem;
    }

    100% {
      --text-fade: 0px;
    }
  }
</style>
