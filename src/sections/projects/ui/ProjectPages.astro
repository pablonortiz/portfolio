---
import type { Locale } from "@/lib/i18n";
import type { Project } from "@/lib/projects";

import ProjectCard from "./ProjectCard.astro";

interface Props {
  lang: Locale;
  projects: Project[];
}

const { lang, projects } = Astro.props;

const roundUpToEven = (count: number) => count + (count % 2);
const rowsMobile = roundUpToEven(projects.length);
const rowsDesktop = roundUpToEven(Math.ceil(projects.length / 2));
---

<div class="project-pages-frame">
  <ul
    class="project-pages"
    data-project-pages
    style={`--rows-mobile: ${rowsMobile}; --rows-desktop: ${rowsDesktop}`}
  >
    {projects.map((project) => (
      <li class="project-page-item">
        <ProjectCard lang={lang} project={project} />
      </li>
    ))}
  </ul>
</div>
<style>
  .project-pages-frame {
    container-type: inline-size;
  }

  /*
   * One grid, two page sizes: the visible area is exactly two rows, so a page is
   * 2 projects on mobile and 4 on desktop. The first item of each page is the
   * snap target; rows are padded to an even count so the last page can still
   * snap to the top. Cards are always 16:9, with the row height taken from the
   * width; on desktop it's capped so two rows fit the folder's maximum
   * (--pages-max-height), and then cards narrow instead of cropping their video.
   * The padding is smaller than the gap so the next page's first row always
   * stays below the edge.
   */
  .project-pages {
    --gap: 1.25rem;
    --padding: 1rem;
    --rows: var(--rows-mobile);
    --row-height: calc((100cqw - 2 * var(--padding)) * 9 / 16);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: repeat(var(--rows), var(--row-height));
    gap: var(--gap);
    height: calc(2 * var(--row-height) + var(--gap) + 2 * var(--padding));
    padding: var(--padding);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-padding-top: var(--padding);
    scrollbar-width: none;
  }

  .project-pages::-webkit-scrollbar {
    display: none;
  }

  .project-page-item:nth-child(2n + 1) {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (width >= 48rem) {
    .project-pages {
      --rows: var(--rows-desktop);
      --row-height: min(
        (100cqw - 2 * var(--padding) - var(--gap)) / 2 * 9 / 16,
        (var(--pages-max-height, 100dvh) - 2 * var(--padding) - var(--gap)) / 2
      );
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-page-item {
      width: min(100%, var(--row-height) * 16 / 9);
    }

    .project-page-item:nth-child(odd) {
      justify-self: end;
    }

    .project-page-item:nth-child(even) {
      justify-self: start;
    }

    .project-page-item:nth-child(2n + 1) {
      scroll-snap-align: none;
    }

    .project-page-item:nth-child(4n + 1) {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }

  /*
   * Each card enters as it scrolls into the folder and settles once it's fully
   * in, which is when its page snaps. Tied to the folder's scroll, not to time:
   * no added delay, and it rewinds when scrolling back.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /*
       * Longhands on purpose: the build's minifier (Lightning CSS) folds a
       * shorthand plus animation-timeline into one "animation" that Chrome
       * rejects, which silently drops the animation.
       */
      .project-page-item {
        animation-name: card-enter;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }

      @media (width >= 48rem) {
        .project-page-item:nth-child(even) {
          animation-range: entry 25% entry 100%;
        }
      }
    }
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      translate: 0 1.5rem;
      scale: 0.96;
    }
  }
</style>
