---
import DesktopIcon from "@/assets/icons/monitor.svg";
import MobileIcon from "@/assets/icons/smartphone.svg";
import TerminalIcon from "@/assets/icons/terminal.svg";
import WebIcon from "@/assets/icons/globe.svg";
import { projectCategories } from "@/config/projects";
import type { Locale } from "@/lib/i18n";
import type { Project } from "@/lib/projects";

import ProjectPages from "./ProjectPages.astro";
import { projectsTexts } from "../projects.texts";

interface Props {
  lang: Locale;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const texts = projectsTexts[lang];

const categoryIcons = {
  web: WebIcon,
  mobile: MobileIcon,
  desktop: DesktopIcon,
  dev: TerminalIcon,
};
const projectsByCategory = Map.groupBy(projects, (project) => project.category);
const categories = projectCategories.filter((category) =>
  projectsByCategory.has(category),
);
const [defaultCategory] = categories;
---

<div class="project-folder" data-project-folder data-url-param={texts.urlParam}>
  <div role="tablist" aria-label={texts.tablistLabel} class="project-tabs">
    {categories.map((category) => {
      const Icon = categoryIcons[category];
      const selected = category === defaultCategory;
      return (
        <button
          type="button"
          role="tab"
          id={`tab-${category}`}
          aria-controls={`panel-${category}`}
          aria-selected={selected}
          tabindex={selected ? 0 : -1}
          data-category={category}
          class="project-tab"
        >
          <Icon class="size-4" aria-hidden="true" />
          <span class="project-tab-label">{texts.categories[category]}</span>
        </button>
      );
    })}
  </div>
  <div class="project-panels">
    {categories.map((category) => (
      <div
        role="tabpanel"
        id={`panel-${category}`}
        aria-labelledby={`tab-${category}`}
        hidden={category !== defaultCategory}
        class="project-panel"
      >
        <ProjectPages
          lang={lang}
          projects={projectsByCategory.get(category) ?? []}
        />
      </div>
    ))}
  </div>
</div>

<script>
  import { setupProjectTabs } from "../lib/project-tabs";

  document
    .querySelectorAll<HTMLElement>("[data-project-folder]")
    .forEach(setupProjectTabs);
</script>

<style>
  .project-folder {
    display: flex;
    flex-direction: column;
  }

  @media (width >= 48rem) {
    .project-folder {
      height: calc(100dvh - 8rem);
    }
  }

  .project-tabs {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .project-tab {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 0.75rem 0.75rem 0 0;
    color: var(--color-muted);
  }

  /* On narrow screens inactive tabs show only their icon; the label stays for screen readers. */
  @media (width < 48rem) {
    .project-tab[aria-selected="false"] .project-tab-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .project-tab[aria-selected="true"] {
    border-color: var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .project-panels {
    flex: 1;
    min-height: 0;
    margin-top: -1px;
    border: 1px solid var(--color-border);
    border-radius: 0 1rem 1rem 1rem;
    overflow: hidden;
  }

  .project-panel {
    height: 100%;
  }
</style>
