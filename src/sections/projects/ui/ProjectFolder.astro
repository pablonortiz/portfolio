---
import DesktopIcon from "@/assets/icons/monitor.svg";
import MobileIcon from "@/assets/icons/smartphone.svg";
import TerminalIcon from "@/assets/icons/terminal.svg";
import WebIcon from "@/assets/icons/globe.svg";
import { projectCategories } from "@/config/projects";
import type { Locale } from "@/lib/i18n";
import type { Project } from "@/lib/projects";

import ProjectPages from "./ProjectPages.astro";
import { projectsTexts } from "../projects.texts";

interface Props {
  lang: Locale;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const texts = projectsTexts[lang];

const categoryIcons = {
  web: WebIcon,
  mobile: MobileIcon,
  desktop: DesktopIcon,
  dev: TerminalIcon,
};
const projectsByCategory = Map.groupBy(projects, (project) => project.category);
const categories = projectCategories.filter((category) =>
  projectsByCategory.has(category),
);
const [defaultCategory] = categories;
---

<div
  class="project-folder"
  data-project-folder
  data-url-param={texts.urlParam}
  data-active-category={defaultCategory}
>
  <div role="tablist" aria-label={texts.tablistLabel} class="project-tabs">
    <span class="project-tab-indicator" aria-hidden="true"></span>
    {categories.map((category) => {
      const Icon = categoryIcons[category];
      const selected = category === defaultCategory;
      return (
        <button
          type="button"
          role="tab"
          id={`tab-${category}`}
          aria-controls={`panel-${category}`}
          aria-selected={selected}
          tabindex={selected ? 0 : -1}
          data-category={category}
          class="project-tab"
        >
          <Icon class="size-4" aria-hidden="true" />
          <span class="project-tab-label">
            {texts.categories[category]}
            {category === "dev" && (
              <span class="project-tab-cursor" aria-hidden="true">
                _
              </span>
            )}
          </span>
        </button>
      );
    })}
  </div>
  <p
    class="project-page-indicator"
    data-project-indicator
    aria-hidden="true"
  ></p>
  <div class="project-panels">
    {categories.map((category) => (
      <div
        role="tabpanel"
        id={`panel-${category}`}
        aria-labelledby={`tab-${category}`}
        hidden={category !== defaultCategory}
        data-category={category}
        class="project-panel"
      >
        <ProjectPages
          lang={lang}
          projects={projectsByCategory.get(category) ?? []}
        />
      </div>
    ))}
  </div>
</div>

<script>
  import { onEveryPage } from "@/lib/page-lifecycle";

  import { setupCardVideos } from "../lib/card-videos";
  import { setupPageIndicator } from "../lib/page-indicator";
  import { setupProjectTabs } from "../lib/project-tabs";

  onEveryPage((signal) =>
    document
      .querySelectorAll<HTMLElement>("[data-project-folder]")
      .forEach((folder) => {
        setupProjectTabs(folder, signal);
        setupPageIndicator(folder, signal);
        setupCardVideos(folder, signal);
      }),
  );
</script>

<style>
  /*
   * --pages-max-height is the tallest the pages may be so the whole folder fits
   * below the header (4rem) and the section's padding (2 × 2rem); the panels'
   * top border overlaps the tabs by 1px.
   */
  .project-folder {
    --tabs-height: 2.75rem;
    --pages-max-height: calc(100dvh - 8rem - var(--tabs-height) - 1px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "tabs" "panels" "indicator";
  }

  /* The page indicator sits beside the tabs on desktop; on mobile they leave no room for it, so it goes below. */
  @media (width >= 48rem) {
    .project-folder {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "tabs indicator" "panels panels";
    }
  }

  /*
   * Each category's colors (all from the violet family; Dev is a dark terminal
   * in both themes). The folder takes the active category's (tabs and outline);
   * each panel keeps its own, so the leaving one doesn't change color mid-reveal.
   */
  .project-folder[data-active-category="web"],
  .project-panel[data-category="web"] {
    --folder-background: light-dark(oklch(94% 0.05 268), oklch(23% 0.075 268));
    --folder-foreground: light-dark(oklch(17% 0.03 285), oklch(96% 0.01 285));
    --folder-muted: light-dark(oklch(46% 0.04 268), oklch(74% 0.04 268));
    --folder-accent: light-dark(oklch(50% 0.2 268), oklch(76% 0.13 268));
  }

  .project-folder[data-active-category="mobile"],
  .project-panel[data-category="mobile"] {
    --folder-background: light-dark(oklch(94% 0.05 292), oklch(23% 0.085 292));
    --folder-foreground: light-dark(oklch(17% 0.03 285), oklch(96% 0.01 285));
    --folder-muted: light-dark(oklch(46% 0.04 292), oklch(74% 0.04 292));
    --folder-accent: light-dark(oklch(52% 0.23 292), oklch(76% 0.15 292));
  }

  .project-folder[data-active-category="desktop"],
  .project-panel[data-category="desktop"] {
    --folder-background: light-dark(oklch(94% 0.05 328), oklch(23% 0.08 328));
    --folder-foreground: light-dark(oklch(17% 0.03 285), oklch(96% 0.01 285));
    --folder-muted: light-dark(oklch(46% 0.04 328), oklch(74% 0.04 328));
    --folder-accent: light-dark(oklch(52% 0.21 328), oklch(76% 0.15 328));
  }

  .project-folder[data-active-category="dev"],
  .project-panel[data-category="dev"] {
    --folder-background: light-dark(
      oklch(17% 0.025 285),
      oklch(11.5% 0.02 285)
    );
    --folder-foreground: oklch(94% 0.015 290);
    --folder-muted: oklch(70% 0.03 290);
    --folder-accent: oklch(80% 0.13 300);
  }

  /*
   * Theme scope: these redefine the semantic tokens with their category's
   * colors, so everything inside takes them without knowing about categories.
   */
  .project-tab[aria-selected="true"],
  .project-tab-indicator,
  .project-panels,
  .project-panel {
    --color-background: var(--folder-background);
    --color-foreground: var(--folder-foreground);
    --color-muted: var(--folder-muted);
    --color-accent: var(--folder-accent);
    --color-border: color-mix(
      in oklab,
      var(--folder-foreground) 14%,
      var(--folder-background)
    );
  }

  /* Its line is reserved even when empty, so switching tabs doesn't shift what's below. */
  .project-page-indicator {
    grid-area: indicator;
    justify-self: end;
    min-height: 1lh;
    margin-top: 0.5rem;
    padding-inline-end: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (width >= 48rem) {
    .project-page-indicator {
      align-self: center;
      margin-top: 0;
    }
  }

  .project-tabs {
    grid-area: tabs;
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.25rem;
    height: var(--tabs-height);
  }

  /*
   * The active tab's shape: JS measures the active tab and slides it there.
   * Hidden until JS positions it: going from display none to visible never
   * transitions, so the first position doesn't animate.
   */
  .project-tab-indicator {
    display: none;
    position: absolute;
    top: 0;
    bottom: -1px;
    left: 0;
    width: var(--indicator-width, 0);
    translate: var(--indicator-x, 0) 0;
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: 0.75rem 0.75rem 0 0;
    background: var(--color-background);
    transition:
      translate var(--duration-slow) var(--ease-out),
      width var(--duration-slow) var(--ease-out),
      background-color var(--duration-slow) var(--ease-out),
      border-color var(--duration-slow) var(--ease-out);
  }

  .project-tabs[data-indicator-ready] .project-tab-indicator {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-tab-indicator {
      transition: none;
    }
  }

  .project-tab {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 0.75rem 0.75rem 0 0;
    color: var(--color-muted);
  }

  /* Narrow screens: tighter tabs, and inactive ones show only their icon (the label stays for screen readers). All four fit at 320px. */
  @media (width < 48rem) {
    .project-tab {
      padding-inline: 0.75rem;
    }

    .project-tab[aria-selected="false"] .project-tab-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .project-tab[aria-selected="true"] {
    color: var(--color-foreground);
  }

  /* Without JS (indicator never positioned), the active tab draws its own shape. */
  .project-tabs:not([data-indicator-ready]) .project-tab[aria-selected="true"] {
    border-color: var(--color-border);
    background: var(--color-background);
  }

  .project-tab[aria-selected="true"] :global(svg) {
    color: var(--color-accent);
  }

  .project-tab[data-category="dev"] {
    font-family: var(--font-mono);
  }

  /*
   * Blinks 4 × 1 s each time Dev opens, then stays solid: anything blinking on
   * its own for more than 5 s needs a pause control (WCAG 2.2.2). Going from
   * display none to visible restarts the animation.
   */
  .project-tab-cursor {
    display: none;
  }

  .project-tab[aria-selected="true"] .project-tab-cursor {
    display: inline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-tab[aria-selected="true"] .project-tab-cursor {
      animation: cursor-blink 1s steps(1) 4;
    }
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .project-panels {
    grid-area: panels;
    position: relative;
    isolation: isolate;
    margin-top: -1px;
    border: 1px solid var(--color-border);
    border-radius: 0 1rem 1rem 1rem;
    overflow: hidden;
    transition: border-color var(--duration-slow) var(--ease-out);
  }

  .project-panel {
    position: relative;
    z-index: 1;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  /* While the new panel's circle grows (JS), the previous one stays visible underneath. */
  .project-panel[data-leaving] {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-panels {
      transition: none;
    }
  }
</style>
