---
import { Picture } from "astro:assets";

import type { Project } from "@/lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="project-backdrop" aria-hidden="true">
  <Picture
    src={project.poster}
    alt=""
    formats={["avif", "webp"]}
    widths={[640, 1280]}
    sizes="100vw"
    class="project-backdrop-image"
  />
</div>

<style>
  /*
   * The project's last frame behind the whole page. It's blurred and veiled
   * with the theme's background color, so the text on top keeps its contrast
   * in both themes; the image is scaled up so the blur leaves no clear edges.
   * The veil is the lightest that keeps secondary text at 4.5:1 or more over a
   * pure white or black frame, in either theme (measured: 4.9:1 at worst).
   */
  .project-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .project-backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.1;
    filter: blur(24px);
  }

  .project-backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--color-background) 88%, transparent);
  }
</style>
