---
import AstroIcon from "@/assets/icons/tech/astro.svg";
import DartIcon from "@/assets/icons/tech/dart.svg";
import DrizzleIcon from "@/assets/icons/tech/drizzle.svg";
import ElectronIcon from "@/assets/icons/tech/electron.svg";
import ExpoIcon from "@/assets/icons/tech/expo.svg";
import ExpressIcon from "@/assets/icons/tech/express.svg";
import FlutterIcon from "@/assets/icons/tech/flutter.svg";
import JavascriptIcon from "@/assets/icons/tech/javascript.svg";
import KotlinIcon from "@/assets/icons/tech/kotlin.svg";
import NodejsIcon from "@/assets/icons/tech/nodejs.svg";
import NpmIcon from "@/assets/icons/tech/npm.svg";
import PostgresqlIcon from "@/assets/icons/tech/postgresql.svg";
import PrismaIcon from "@/assets/icons/tech/prisma.svg";
import ReactIcon from "@/assets/icons/tech/react.svg";
import ReduxIcon from "@/assets/icons/tech/redux.svg";
import SqliteIcon from "@/assets/icons/tech/sqlite.svg";
import SupabaseIcon from "@/assets/icons/tech/supabase.svg";
import TailwindCssIcon from "@/assets/icons/tech/tailwind-css.svg";
import TanstackQueryIcon from "@/assets/icons/tech/tanstack-query.svg";
import TypescriptIcon from "@/assets/icons/tech/typescript.svg";
import { technologyNames, type TechnologyId } from "@/config/technologies";

interface Props {
  technologies: TechnologyId[];
  label: string;
}

const { technologies, label } = Astro.props;

const technologyIcons = {
  astro: AstroIcon,
  dart: DartIcon,
  drizzle: DrizzleIcon,
  electron: ElectronIcon,
  expo: ExpoIcon,
  express: ExpressIcon,
  flutter: FlutterIcon,
  javascript: JavascriptIcon,
  kotlin: KotlinIcon,
  nodejs: NodejsIcon,
  npm: NpmIcon,
  postgresql: PostgresqlIcon,
  prisma: PrismaIcon,
  react: ReactIcon,
  "react-native": ReactIcon,
  redux: ReduxIcon,
  sqlite: SqliteIcon,
  supabase: SupabaseIcon,
  "tailwind-css": TailwindCssIcon,
  "tanstack-query": TanstackQueryIcon,
  typescript: TypescriptIcon,
  // Simple Icons has no logo for these two (Zustand's official one is a full-color illustration): name only.
  riverpod: null,
  zustand: null,
} satisfies Record<TechnologyId, unknown>;
---

<div class="technology-strip" data-technology-strip data-label={label}>
  <div class="technology-track" data-technology-track>
    <ul class="technology-list">
      {technologies.map((technology) => {
        const Icon = technologyIcons[technology];
        return (
          <li class="technology">
            {Icon && <Icon class="size-4 shrink-0" aria-hidden="true" />}
            {technologyNames[technology]}
          </li>
        );
      })}
    </ul>
  </div>
</div>

<script>
  import { onEveryPage } from "@/lib/page-lifecycle";

  import { setupTechnologyStrip } from "../lib/technology-strip";

  onEveryPage((signal) =>
    document
      .querySelectorAll<HTMLElement>("[data-technology-strip]")
      .forEach((strip) => setupTechnologyStrip(strip, signal)),
  );
</script>

<style>
  /* One line: still, it scrolls sideways if it doesn't fit (no JS, reduced motion). */
  .technology-strip {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  /* Moving (JS, only when it doesn't fit): the edges fade and it can be dragged sideways. */
  .technology-strip[data-moving] {
    overflow: hidden;
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
  }

  .technology-strip[data-moving]:active {
    cursor: grabbing;
  }

  .technology-track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
  }

  .technology-list {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .technology {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    /* Mixed from the text color so it shows over any backdrop (the project's frame), in both themes. */
    border: 1px solid
      color-mix(in oklab, var(--color-foreground) 18%, transparent);
    border-radius: 9999px;
  }
</style>
