---
import type { Locale } from "@/lib/i18n";
import { getProjectPath } from "@/lib/locale-url";
import { isPackage, type Project } from "@/lib/projects";

import AppCardBody from "./AppCardBody.astro";
import PackageCardBody from "./PackageCardBody.astro";

interface Props {
  lang: Locale;
  project: Project;
}

const { lang, project } = Astro.props;
---

<a
  href={getProjectPath(lang, project.slug)}
  class="relative block size-full overflow-hidden rounded-xl [view-transition-class:project-zoom]"
  data-project-card
  data-slug={project.slug}
  transition:name={`project-${project.slug}`}
  aria-labelledby={
    isPackage(project) ? `package-${project.slug}-name` : undefined
  }
>
  {isPackage(project) ? (
    <PackageCardBody project={project} />
  ) : (
    <AppCardBody lang={lang} project={project} />
  )}
</a>
