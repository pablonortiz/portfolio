---
import { Picture } from "astro:assets";

import type { Locale } from "@/lib/i18n";
import { getProjectPath } from "@/lib/locale-url";
import type { Project } from "@/lib/projects";

import { getClipSources } from "../lib/video-sources";
import { projectsTexts } from "../projects.texts";

interface Props {
  lang: Locale;
  project: Project;
}

const { lang, project } = Astro.props;
const clip = project.npmPackage ? undefined : getClipSources(project.slug);
---

<a
  href={getProjectPath(lang, project.slug)}
  class="relative block size-full overflow-hidden rounded-xl [view-transition-class:project-zoom]"
  data-project-card
  data-slug={project.slug}
  transition:name={`project-${project.slug}`}
>
  <Picture
    src={project.poster}
    alt=""
    formats={["avif", "webp"]}
    widths={[400, 640, 960]}
    sizes="(min-width: 768px) 34rem, 90vw"
    class="size-full object-cover"
  />
  {clip && (
    <video
      class="absolute inset-0 size-full object-cover"
      data-card-video
      transition:persist={`clip-${project.slug}`}
      muted
      playsinline
      preload="none"
      data-first-frame={clip.firstFrame}
      aria-hidden="true"
      hidden
    >
      {clip.sources.map((source) => (
        <source src={source.src} type={source.type} />
      ))}
    </video>
  )}
  <span class="absolute bottom-3 left-3 rounded-md bg-background/85 px-2 py-1 text-sm">
    {project.title}
  </span>
  {project.fictionalBrand && (
    <span class="absolute top-3 right-3 rounded-md bg-background/85 px-2 py-0.5 font-mono text-xs">
      {projectsTexts[lang].fictionalBrand}
    </span>
  )}
</a>
