---
import type { PackageProject } from "@/lib/projects";

import { getNpmPackageInfo } from "../lib/npm-package";

interface Props {
  project: PackageProject;
}

const { project } = Astro.props;
const info = await getNpmPackageInfo(project.npmPackage);
---

<div class="package-card-body">
  <p class="package-name" id={`package-${project.slug}-name`}>
    <span class="package-prompt" aria-hidden="true">
      &gt;
    </span>
    {project.title}
  </p>
  <p class="package-summary">{project.summary}</p>
  {info && <p class="package-version">v{info.version}</p>}
</div>

<style>
  /* An npm package has no clip: its card is a terminal with its name, summary and version (docs/projects.md §42.1). */
  .package-card-body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: inherit;
    font-family: var(--font-mono);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  :global([data-project-card]:hover) .package-card-body {
    border-color: var(--color-accent);
  }

  .package-name {
    font-size: 1.25rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .package-prompt {
    margin-inline-end: 0.5ch;
    color: var(--color-accent);
  }

  .package-summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-muted);
    font-family: var(--font-sans);
  }

  .package-version {
    justify-self: end;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
