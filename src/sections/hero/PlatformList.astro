---
import DesktopIcon from "@/assets/icons/monitor.svg";
import MobileIcon from "@/assets/icons/smartphone.svg";
import WebIcon from "@/assets/icons/globe.svg";
import type { Locale } from "@/lib/i18n";

import { heroTexts } from "./hero.texts";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const { platforms, platformsLabel } = heroTexts[lang];
---

<ul
  aria-label={platformsLabel}
  class:list={["grid w-fit grid-cols-2 gap-x-10 gap-y-3", className]}
>
  <li class="flex translate-y-3 items-center gap-2">
    <WebIcon class="size-5" aria-hidden="true" />
    {platforms.web}
  </li>
  <li class="flex items-center gap-2">
    <MobileIcon class="size-5" aria-hidden="true" />
    {platforms.mobile}
  </li>
  <li class="col-span-2 flex items-center gap-2 justify-self-center">
    <DesktopIcon class="size-5" aria-hidden="true" />
    {platforms.desktop}
  </li>
</ul>
