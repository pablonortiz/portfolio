---
import ArrowDownIcon from "@/assets/icons/arrow-down.svg";
import { sectionIds } from "@/config/navigation";
import type { Locale } from "@/lib/i18n";

import { getRevealTiming } from "./lib/reveal-timing";
import HeroPhoto from "./ui/HeroPhoto.astro";
import PlatformList from "./ui/PlatformList.astro";
import { heroTexts } from "./hero.texts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const texts = heroTexts[lang];
const projectsHref = `#${sectionIds[lang].projects}`;

const { groupStyles, totalWords } = getRevealTiming([
  [texts.greeting],
  [texts.intro, texts.name],
  [texts.taglineLines[0]],
  [texts.taglineLines[1]],
]);
---

<section
  style={`--total-words: ${totalWords}`}
  class="hero relative mx-auto grid min-h-[calc(100dvh-4rem)] max-w-6xl content-center justify-items-center gap-5 px-6 pt-6 pb-14 text-center md:grid-cols-2 md:grid-rows-[1fr_auto_auto_auto_1fr] md:justify-items-start md:gap-x-12 md:text-left"
>
  <h1 class="md:col-start-1 md:row-start-2">
    <span class="block text-xl text-muted">
      <span class="hero-reveal" style={groupStyles[0]}>
        {texts.greeting}
      </span>{" "}
      <span class="hero-reveal" style={groupStyles[1]}>
        {texts.intro}
      </span>
    </span>
    <span
      class="hero-reveal block font-display text-5xl font-extrabold tracking-tight"
      style={groupStyles[1]}
    >
      {texts.name}
    </span>
  </h1>

  <HeroPhoto
    alt={texts.photoAlt}
    class="w-[min(70vw,30dvh)] md:col-start-2 md:row-span-full md:w-full md:max-w-md md:self-center md:justify-self-end max-md:[@media(max-height:700px)]:w-[min(70vw,25dvh)]"
  />

  <p class="text-2xl md:col-start-1 md:row-start-3">
    <span class="hero-reveal block" style={groupStyles[2]}>
      {texts.taglineLines[0]}
    </span>
    <span class="hero-reveal block" style={groupStyles[3]}>
      {texts.taglineLines[1]}
    </span>
  </p>

  <div class="flex flex-col items-center gap-5 md:col-start-1 md:row-start-4 md:items-start">
    <PlatformList lang={lang} />
    <a
      href={projectsHref}
      class="rounded-full bg-accent px-6 py-3 text-accent-foreground"
      data-smooth-scroll
    >
      {texts.cta}
    </a>
  </div>

  <a
    href={projectsHref}
    aria-hidden="true"
    tabindex="-1"
    data-smooth-scroll
    class="absolute bottom-0 left-1/2 flex h-8 w-16 -translate-x-1/2 items-end justify-center rounded-t-full border border-b-0 border-border pb-1"
  >
    <ArrowDownIcon class="size-4" />
  </a>
</section>

<script>
  import { onEveryPage } from "@/lib/page-lifecycle";

  import { skipIntroOnLaterNavigations } from "./lib/hero-intro";
  import { scrollSmoothlyOnClick } from "./lib/smooth-scroll";

  skipIntroOnLaterNavigations();
  onEveryPage(() =>
    document
      .querySelectorAll<HTMLAnchorElement>("[data-smooth-scroll]")
      .forEach(scrollSmoothlyOnClick),
  );
</script>

<style>
  .hero {
    --reading-pace: 350ms;
    --orbit-start: calc(var(--total-words) * var(--reading-pace));
  }

  /*
   * Scrolling to the projects, the Hero dims and shrinks a little while the
   * folder rises over it (docs/projects.md §42.6), on the folder's own
   * timeline (shared by the home page). Longhands because the build's minifier
   * breaks the shorthand plus animation-timeline.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Shrinking from its top edge: Chrome snaps to the transformed box, and from the center the Hero's chapter point moved 15px. */
      .hero {
        transform-origin: 50% 0;
        animation-name: hero-recede;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: --projects-entry;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes hero-recede {
    to {
      opacity: 0.4;
      scale: 0.96;
    }
  }

  /* Intro already seen this visit: every intro timing derives from the pace, so it all lands in its final state (the orbit still spins). */
  :global(html[data-hero-intro-seen]) .hero {
    --reading-pace: 0ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* backwards: while waiting for its turn, each group shows the first keyframe (dimmed). */
    .hero-reveal {
      animation: hero-reveal var(--ease-in-out) backwards;
      animation-duration: calc(var(--words) * var(--reading-pace));
      animation-delay: calc(var(--words-before) * var(--reading-pace));
    }
  }

  @keyframes hero-reveal {
    from {
      opacity: 0.35;
    }
  }
</style>
