---
import "@/styles/global.css";

import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Header from "@/components/navigation/Header.astro";
import { siteName } from "@/config/site";
import { locales, openGraphLocales, type Locale } from "@/lib/i18n";
import { getLocalizedUrl, languageNeutralUrl } from "@/lib/locale-url";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The home also has a language-neutral version: the root, which picks the browser's language. */
  isHome?: boolean;
}

const { lang, title, description, isHome = false } = Astro.props;
const canonicalUrl = getLocalizedUrl(Astro.url.pathname, lang);
const otherLocales = locales.filter((locale) => locale !== lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Applies the saved theme before the first paint, so the page never flashes the wrong one.
      // ClientRouter replaces <html>'s attributes on every navigation, so it's applied after each swap too.
      const applySavedTheme = () => {
        try {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {
          // Storage blocked: the page follows the system theme.
        }
      };
      applySavedTheme();
      document.addEventListener("astro:after-swap", applySavedTheme);
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-geist-mono" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={getLocalizedUrl(Astro.url.pathname, locale)}
      />
    ))}
    {isHome && (
      <link rel="alternate" hreflang="x-default" href={languageNeutralUrl} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocales[lang]} />
    {otherLocales.map((locale) => (
      <meta property="og:locale:alternate" content={openGraphLocales[locale]} />
    ))}
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
