---
import Header from "@/components/navigation/Header.astro";
import { siteName } from "@/config/site";
import { locales, openGraphLocales, type Locale } from "@/lib/i18n";
import { getLocalizedUrl, languageNeutralUrl } from "@/lib/locale-url";
import type { OgImage } from "@/lib/og-image/og-image";

import DocumentLayout from "./DocumentLayout.astro";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The card shown when the page's link is shared. */
  image: OgImage;
  /** The home also has a language-neutral version: the root, which picks the browser's language. */
  isHome?: boolean;
}

const { lang, title, description, image, isHome = false } = Astro.props;
const canonicalUrl = getLocalizedUrl(Astro.url.pathname, lang);
const otherLocales = locales.filter((locale) => locale !== lang);
---

<DocumentLayout lang={lang} title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={getLocalizedUrl(Astro.url.pathname, locale)}
      />
    ))}
    {isHome && (
      <link rel="alternate" hreflang="x-default" href={languageNeutralUrl} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={openGraphLocales[lang]} />
    {otherLocales.map((locale) => (
      <meta property="og:locale:alternate" content={openGraphLocales[locale]} />
    ))}
  </Fragment>
  <Header lang={lang} />
  <main>
    <slot />
  </main>
  <slot name="footer" />
</DocumentLayout>
